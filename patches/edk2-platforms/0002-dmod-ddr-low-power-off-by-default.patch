diff --git a/Platform/Radxa/Platforms/CIX/Sky1/Drivers/RadxaSetupVariableInitDxe/RadxaSetupVariableInitDxe.c b/Platform/Radxa/Platforms/CIX/Sky1/Drivers/RadxaSetupVariableInitDxe/RadxaSetupVariableInitDxe.c
index 1e372aa..ebd9535 100644
--- a/Platform/Radxa/Platforms/CIX/Sky1/Drivers/RadxaSetupVariableInitDxe/RadxaSetupVariableInitDxe.c
+++ b/Platform/Radxa/Platforms/CIX/Sky1/Drivers/RadxaSetupVariableInitDxe/RadxaSetupVariableInitDxe.c
@@ -11,7 +11,53 @@
 #include <Library/BaseLib.h>
 #include <Library/BaseMemoryLib.h>
 #include <Library/PcdLib.h>
+#include <Library/ArmSmcLib.h>
 #include "../../Include/RadxaSetupVar.h"
+#include "../../Include/DmodSetupVar.h"
+
+// dmod: same SiP call as Linux drivers/soc/cix/cix-ddr-lp.c (CIX_SIP_SET_DDRLP); Arg1: 0 = off, 1 = on.
+#define CIX_SIP_SET_DDRLP  0xC2000010
+
+//
+// dmod: reads DmodSetupVar (creating it with the default, DDR low-power off, when it is missing
+// or not the expected size) and turns the firmware DDR low-power mode off unless it is set to Enabled.
+//
+STATIC
+VOID
+DmodApplyDdrLowPower (
+  VOID
+  )
+{
+  EFI_STATUS       Status;
+  UINTN            VarSize;
+  DMOD_SETUP_DATA  DmodSetupVar;
+  ARM_SMC_ARGS     Args;
+
+  VarSize = sizeof (DmodSetupVar);
+  Status  = gRT->GetVariable (DMOD_SETUP_VAR, &gRadxaSetupVariableGuid, NULL, &VarSize, &DmodSetupVar);
+  if (EFI_ERROR (Status) || (VarSize != sizeof (DmodSetupVar))) {
+    ZeroMem (&DmodSetupVar, sizeof (DmodSetupVar));
+    Status = gRT->SetVariable (
+                    DMOD_SETUP_VAR,
+                    &gRadxaSetupVariableGuid,
+                    EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS,
+                    sizeof (DmodSetupVar),
+                    &DmodSetupVar
+                    );
+    DEBUG ((DEBUG_INFO, "%a: %s created with defaults - %r\n", __func__, DMOD_SETUP_VAR, Status));
+  }
+
+  if (DmodSetupVar.DdrLowPower != DMOD_DDR_LP_OFF) {
+    DEBUG ((DEBUG_INFO, "%a: DDR low-power left at firmware default\n", __func__));
+    return;
+  }
+
+  ZeroMem (&Args, sizeof (Args));
+  Args.Arg0 = CIX_SIP_SET_DDRLP;
+  Args.Arg1 = 0;
+  ArmCallSmc (&Args);
+  DEBUG ((DEBUG_INFO, "%a: DDR low-power turned off (ret 0x%lx)\n", __func__, Args.Arg0));
+}
 
 EFI_STATUS
 EFIAPI
@@ -24,6 +70,8 @@ RadxaSetupVariableInitDxeEntry (
   UINTN             VarSize;
   RADXA_SETUP_DATA  RadxaSetupVar;
 
+  DmodApplyDdrLowPower ();  // dmod
+
   VarSize = sizeof (RADXA_SETUP_DATA);
 
   Status = gRT->GetVariable (
