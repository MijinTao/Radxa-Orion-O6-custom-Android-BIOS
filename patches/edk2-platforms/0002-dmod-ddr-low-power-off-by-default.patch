diff --git a/Platform/Radxa/Platforms/CIX/Sky1/Include/DmodSetupVar.h b/Platform/Radxa/Platforms/CIX/Sky1/Include/DmodSetupVar.h
new file mode 100644
index 0000000..4e15145
--- /dev/null
+++ b/Platform/Radxa/Platforms/CIX/Sky1/Include/DmodSetupVar.h
@@ -0,0 +1,22 @@
+#ifndef _DMOD_SETUP_VAR_H_
+#define _DMOD_SETUP_VAR_H_
+
+//
+// dmod settings. Kept in their own UEFI variable so Radxa's RadxaSetupVar stays exactly as stock.
+// Same vendor GUID as RadxaSetupVar (RADXA_SETUP_VARIABLE_GUID), different name.
+//
+#define DMOD_SETUP_VAR  L"DmodSetupVar"
+
+// DdrLowPower: firmware DDR low-power mode (CIX SiP call 0xC2000010)
+#define DMOD_DDR_LP_OFF  0   // default: turned off at every boot
+#define DMOD_DDR_LP_ON   1   // leave the firmware default
+
+#pragma pack(1)
+
+typedef struct {
+  UINT8     DdrLowPower;
+} DMOD_SETUP_DATA;
+
+#pragma pack()
+
+#endif
