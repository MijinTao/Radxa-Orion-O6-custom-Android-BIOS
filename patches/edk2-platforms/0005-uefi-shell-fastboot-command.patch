diff --git a/Platform/Radxa/Platforms/CIX/Sky1/Drivers/DmodFastbootCommandDxe/DmodFastbootCommandDxe.c b/Platform/Radxa/Platforms/CIX/Sky1/Drivers/DmodFastbootCommandDxe/DmodFastbootCommandDxe.c
new file mode 100644
index 0000000..4f7f30e
--- /dev/null
+++ b/Platform/Radxa/Platforms/CIX/Sky1/Drivers/DmodFastbootCommandDxe/DmodFastbootCommandDxe.c
@@ -0,0 +1,154 @@
+/** @file
+  dmod: built-in UEFI Shell command "fastboot".
+
+  Registers a Shell dynamic command named "fastboot" that starts the BIOS's own fastboot application (the CIX
+  Fastboot app in the firmware volume, gCixFastBootAppGuid - the same one LaunchFastbootDxe and the setup
+  hotkey start). The Shell checks built-in and dynamic commands before .nsh/.efi files, so "fastboot" works at
+  any Shell prompt, with or without a USB stick. The PC sees the board when the USB-C DRD port is in device role
+  (the default in this BIOS).
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/DevicePathLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Protocol/FirmwareVolume2.h>
+#include <Protocol/ShellDynamicCommand.h>
+
+STATIC CONST CHAR16  mDmodFastbootHelp[] =
+  L".TH fastboot 0 \"Starts fastboot mode to flash Android from a PC.\"\r\n"
+  L".SH NAME\r\n"
+  L"Starts fastboot mode to flash Android from a PC.\r\n"
+  L".SH SYNOPSIS\r\n"
+  L" \r\n"
+  L"FASTBOOT\r\n"
+  L".SH DESCRIPTION\r\n"
+  L" \r\n"
+  L"NOTES:\r\n"
+  L"  1. Starts the BIOS's own fastboot application on the USB-C data port.\r\n"
+  L"  2. Connect that port to the PC, then on the PC: fastboot devices\r\n"
+  L"  3. The USB-C port must be in device role (default in this dmod BIOS;\r\n"
+  L"     setup: USB configuration, data role).\r\n"
+  L"  4. Added by dmod patch 0005 (built-in command, no USB stick needed).\r\n";
+
+/**
+  Finds the CIX fastboot application in the firmware volumes and returns its device path.
+**/
+STATIC
+EFI_STATUS
+DmodFindFastbootApp (
+  OUT EFI_DEVICE_PATH_PROTOCOL  **DevicePath
+  )
+{
+  EFI_STATUS                         Status;
+  EFI_HANDLE                         *Handles;
+  UINTN                              Count;
+  UINTN                              Index;
+  EFI_FIRMWARE_VOLUME2_PROTOCOL      *Fv;
+  UINTN                              Size;
+  EFI_FV_FILETYPE                    Type;
+  EFI_FV_FILE_ATTRIBUTES             Attributes;
+  UINT32                             AuthStatus;
+  MEDIA_FW_VOL_FILEPATH_DEVICE_PATH  FileNode;
+
+  *DevicePath = NULL;
+  Status      = gBS->LocateHandleBuffer (ByProtocol, &gEfiFirmwareVolume2ProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = EFI_NOT_FOUND;
+  for (Index = 0; Index < Count; Index++) {
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiFirmwareVolume2ProtocolGuid, (VOID **)&Fv))) {
+      continue;
+    }
+
+    // Buffer NULL: only checks that the file is in this volume
+    if (EFI_ERROR (Fv->ReadFile (Fv, &gCixFastBootAppGuid, NULL, &Size, &Type, &Attributes, &AuthStatus))) {
+      continue;
+    }
+
+    EfiInitializeFwVolDevicepathNode (&FileNode, &gCixFastBootAppGuid);
+    *DevicePath = AppendDevicePathNode (DevicePathFromHandle (Handles[Index]), (EFI_DEVICE_PATH_PROTOCOL *)&FileNode);
+    Status      = (*DevicePath == NULL) ? EFI_OUT_OF_RESOURCES : EFI_SUCCESS;
+    break;
+  }
+
+  FreePool (Handles);
+  return Status;
+}
+
+STATIC
+SHELL_STATUS
+EFIAPI
+DmodFastbootCommandHandler (
+  IN EFI_SHELL_DYNAMIC_COMMAND_PROTOCOL  *This,
+  IN EFI_SYSTEM_TABLE                    *SystemTable,
+  IN EFI_SHELL_PARAMETERS_PROTOCOL       *ShellParameters,
+  IN EFI_SHELL_PROTOCOL                  *Shell
+  )
+{
+  EFI_STATUS                Status;
+  EFI_DEVICE_PATH_PROTOCOL  *DevicePath;
+  EFI_HANDLE                AppHandle;
+
+  Status = DmodFindFastbootApp (&DevicePath);
+  if (EFI_ERROR (Status)) {
+    Print (L"fastboot: the fastboot application is not in this BIOS (%r)\n", Status);
+    return SHELL_NOT_FOUND;
+  }
+
+  Print (L"fastboot: starting fastboot on the USB-C data port. On the PC: fastboot devices\n");
+  Status = gBS->LoadImage (FALSE, gImageHandle, DevicePath, NULL, 0, &AppHandle);
+  FreePool (DevicePath);
+  if (EFI_ERROR (Status)) {
+    Print (L"fastboot: could not load the fastboot application (%r)\n", Status);
+    return SHELL_LOAD_ERROR;
+  }
+
+  Status = gBS->StartImage (AppHandle, NULL, NULL);
+  if (EFI_ERROR (Status)) {
+    Print (L"fastboot: the fastboot application ended with %r\n", Status);
+    return SHELL_ABORTED;
+  }
+
+  return SHELL_SUCCESS;
+}
+
+STATIC
+CHAR16 *
+EFIAPI
+DmodFastbootCommandGetHelp (
+  IN EFI_SHELL_DYNAMIC_COMMAND_PROTOCOL  *This,
+  IN CONST CHAR8                         *Language
+  )
+{
+  return AllocateCopyPool (sizeof (mDmodFastbootHelp), mDmodFastbootHelp);
+}
+
+STATIC EFI_SHELL_DYNAMIC_COMMAND_PROTOCOL  mDmodFastbootCommand = {
+  L"fastboot",
+  DmodFastbootCommandHandler,
+  DmodFastbootCommandGetHelp
+};
+
+EFI_STATUS
+EFIAPI
+DmodFastbootCommandEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  return gBS->InstallProtocolInterface (
+                &ImageHandle,
+                &gEfiShellDynamicCommandProtocolGuid,
+                EFI_NATIVE_INTERFACE,
+                &mDmodFastbootCommand
+                );
+}
