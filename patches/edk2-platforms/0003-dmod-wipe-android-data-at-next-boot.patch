 }
 
+//
+// dmod: "Wipe Android data at next boot" (one-shot, variable DmodWipeAndroid).
+// Android treats a partition whose first 4 KiB are all zero as wiped and reformats it ("formattable" in
+// fstab.cix); /data then gets a new encryption key from the KeyMint in this BIOS's OP-TEE. Zeroing all of
+// "metadata" and the start of "userdata" is the same as "fastboot erase metadata" + "fastboot erase userdata".
+// Only GPT partitions on NVMe drives are touched. Runs once, at ReadyToBoot, before any boot option starts.
+//
+#define DMOD_WIPE_CHUNK           SIZE_1MB
+#define DMOD_WIPE_USERDATA_BYTES  SIZE_1MB
+
+STATIC
+BOOLEAN
+DmodIsOnNvme (
+  IN EFI_HANDLE  Handle
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+
+  Node = DevicePathFromHandle (Handle);
+  while ((Node != NULL) && !IsDevicePathEnd (Node)) {
+    if ((DevicePathType (Node) == MESSAGING_DEVICE_PATH) && (DevicePathSubType (Node) == MSG_NVME_NAMESPACE_DP)) {
+      return TRUE;
+    }
+
+    Node = NextDevicePathNode (Node);
+  }
+
+  return FALSE;
+}
+
+STATIC
+UINTN
+DmodWipeAndroidPartitions (
+  VOID
+  )
+{
+  EFI_STATUS                   Status;
+  EFI_HANDLE                   *Handles;
+  UINTN                        Count;
+  UINTN                        Index;
+  EFI_PARTITION_INFO_PROTOCOL  *PartInfo;
+  EFI_BLOCK_IO_PROTOCOL        *BlockIo;
+  UINT64                       Bytes;
+  UINT64                       Done;
+  UINTN                        Chunk;
+  VOID                         *Zero;
+  UINTN                        Wiped;
+  CHAR16                       Name[37];
+
+  Wiped  = 0;
+  Chunk  = 0;
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiPartitionInfoProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    return 0;
+  }
+
+  Zero = AllocateZeroPool (DMOD_WIPE_CHUNK);
+  if (Zero == NULL) {
+    FreePool (Handles);
+    return 0;
+  }
+
+  for (Index = 0; Index < Count; Index++) {
+    Status = gBS->HandleProtocol (Handles[Index], &gEfiPartitionInfoProtocolGuid, (VOID **)&PartInfo);
+    if (EFI_ERROR (Status) || (PartInfo->Type != PARTITION_TYPE_GPT) || !DmodIsOnNvme (Handles[Index])) {
+      continue;
+    }
+
+    // copy out of the packed protocol structure (aligned, NUL-terminated)
+    CopyMem (Name, (VOID *)PartInfo->Info.Gpt.PartitionName, sizeof (PartInfo->Info.Gpt.PartitionName));
+    Name[36] = L'\0';
+    if (StrCmp (Name, L"metadata") == 0) {
+      Bytes = MAX_UINT64;                       // all of it (16 MiB)
+    } else if (StrCmp (Name, L"userdata") == 0) {
+      Bytes = DMOD_WIPE_USERDATA_BYTES;         // superblocks + the 4 KiB Android checks
+    } else {
+      continue;
+    }
+
+    Status = gBS->HandleProtocol (Handles[Index], &gEfiBlockIoProtocolGuid, (VOID **)&BlockIo);
+    if (EFI_ERROR (Status) || BlockIo->Media->ReadOnly || (BlockIo->Media->BlockSize == 0) ||
+        ((DMOD_WIPE_CHUNK % BlockIo->Media->BlockSize) != 0))
+    {
+      continue;
+    }
+
+    Bytes = MIN (Bytes, MultU64x32 (BlockIo->Media->LastBlock + 1, BlockIo->Media->BlockSize));
+    for (Done = 0; Done < Bytes; Done += Chunk) {
+      Chunk  = (UINTN)MIN ((UINT64)DMOD_WIPE_CHUNK, Bytes - Done);
+      Status = BlockIo->WriteBlocks (
+                          BlockIo,
+                          BlockIo->Media->MediaId,
+                          DivU64x32 (Done, BlockIo->Media->BlockSize),
+                          Chunk,
+                          Zero
+                          );
+      if (EFI_ERROR (Status)) {
+        break;
+      }
+    }
+
+    BlockIo->FlushBlocks (BlockIo);
+    Print (L"dmod: wiped Android %s: %Lu KiB - %r\n", Name, DivU64x32 (Done, 1024), Status);
+    if (!EFI_ERROR (Status)) {
+      Wiped++;
+    }
+  }
+
+  FreePool (Zero);
+  FreePool (Handles);
+  return Wiped;
+}
+
+STATIC
+VOID
+DmodConnectAll (
+  VOID
+  )
+{
+  EFI_HANDLE  *Handles;
+  UINTN       Count;
+  UINTN       Index;
+
+  if (!EFI_ERROR (gBS->LocateHandleBuffer (AllHandles, NULL, NULL, &Count, &Handles))) {
+    for (Index = 0; Index < Count; Index++) {
+      gBS->ConnectController (Handles[Index], NULL, NULL, TRUE);
+    }
+
+    FreePool (Handles);
+  }
+}
+
+STATIC
+VOID
+EFIAPI
+DmodWipeAndroidOnReadyToBoot (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS      Status;
+  UINTN           VarSize;
+  DMOD_WIPE_DATA  Wipe;
+
+  gBS->CloseEvent (Event);                      // once per boot
+
+  VarSize = sizeof (Wipe);
+  Status  = gRT->GetVariable (DMOD_WIPE_VAR, &gRadxaSetupVariableGuid, NULL, &VarSize, &Wipe);
+  if (EFI_ERROR (Status) || (VarSize != sizeof (Wipe)) || (Wipe.WipeAndroidData != DMOD_WIPE_ANDROID_ON)) {
+    return;
+  }
+
+  // One-shot: switch the option off first; if that fails, wipe nothing (never a wipe on every boot).
+  Wipe.WipeAndroidData = DMOD_WIPE_ANDROID_OFF;
+  Status               = gRT->SetVariable (
+                                DMOD_WIPE_VAR,
+                                &gRadxaSetupVariableGuid,
+                                EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS,
+                                sizeof (Wipe),
+                                &Wipe
+                                );
+  if (EFI_ERROR (Status)) {
+    Print (L"dmod: Wipe Android data: could not reset the option (%r) - nothing wiped\n", Status);
+    return;
+  }
+
+  Print (L"dmod: Wipe Android data at next boot: erasing Android metadata + userdata on NVMe\n");
+  if (DmodWipeAndroidPartitions () == 0) {
+    DmodConnectAll ();                          // NVMe may not be connected yet
+    if (DmodWipeAndroidPartitions () == 0) {
+      Print (L"dmod: no Android metadata/userdata partition found on NVMe - nothing wiped\n");
+    }
+  }
+}
+
+//
+// dmod: creates DmodWipeAndroid (Disabled) when it is missing or not the expected size, so the setup page
+// has storage for the option, and arms the ReadyToBoot check.
+//
+STATIC
+VOID
+DmodInitAndroidWipe (
+  VOID
+  )
+{
+  EFI_STATUS      Status;
+  UINTN           VarSize;
+  DMOD_WIPE_DATA  Wipe;
+  EFI_EVENT       Event;
+
+  VarSize = sizeof (Wipe);
+  Status  = gRT->GetVariable (DMOD_WIPE_VAR, &gRadxaSetupVariableGuid, NULL, &VarSize, &Wipe);
+  if (EFI_ERROR (Status) || (VarSize != sizeof (Wipe))) {
+    ZeroMem (&Wipe, sizeof (Wipe));
+    gRT->SetVariable (
+           DMOD_WIPE_VAR,
+           &gRadxaSetupVariableGuid,
+           EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS,
+           sizeof (Wipe),
+           &Wipe
+           );
+  }
+
+  EfiCreateEventReadyToBootEx (TPL_CALLBACK, DmodWipeAndroidOnReadyToBoot, NULL, &Event);
+}
+
