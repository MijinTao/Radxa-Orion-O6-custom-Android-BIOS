diff --git a/Platform/CIX/Sky1/Drivers/PlatformSetupVariableInitDxe/PlatformSetupVariableInitDxe.c b/Platform/CIX/Sky1/Drivers/PlatformSetupVariableInitDxe/PlatformSetupVariableInitDxe.c
index dd44119..c38d38d 100644
--- a/Platform/CIX/Sky1/Drivers/PlatformSetupVariableInitDxe/PlatformSetupVariableInitDxe.c
+++ b/Platform/CIX/Sky1/Drivers/PlatformSetupVariableInitDxe/PlatformSetupVariableInitDxe.c
@@ -529,6 +529,59 @@ ConstructSetupVariable (
   PlatformSetupVar->SPEEnable               = FixedPcdGet8 (PcdSPEEn);
 }
 
+//
+// dmod: PCIe ASPM is off by default (O6.dsc, as in Radxa's Android 1.0.0 BIOS). A PlatformSetupVar written
+// by an earlier 1.3.2 build keeps its stored ASPM values (L0s+L1), so they are set to the new default once.
+// The marker variable DmodAspmDefault records that this was done, so a later change in setup is kept.
+//
+#define DMOD_ASPM_MARKER_VAR  L"DmodAspmDefault"
+
+STATIC
+VOID
+DmodApplyAspmDefaultOnce (
+  IN OUT PLATFORM_SETUP_DATA  *PlatformSetupVar,
+  IN     BOOLEAN              UpdateStoredVar
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       Size;
+  UINT8       Marker;
+
+  Size   = sizeof (Marker);
+  Status = gRT->GetVariable (DMOD_ASPM_MARKER_VAR, &gPlatformSetupVariableGuid, NULL, &Size, &Marker);
+  if (Status != EFI_NOT_FOUND) {
+    return;   // already done (or the variable store can't be read)
+  }
+
+  if (UpdateStoredVar) {
+    PlatformSetupVar->PcieAspm[0] = FixedPcdGet8 (PcdPcieRootPort0AspmSupport);
+    PlatformSetupVar->PcieAspm[1] = FixedPcdGet8 (PcdPcieRootPort1AspmSupport);
+    PlatformSetupVar->PcieAspm[2] = FixedPcdGet8 (PcdPcieRootPort2AspmSupport);
+    PlatformSetupVar->PcieAspm[3] = FixedPcdGet8 (PcdPcieRootPort3AspmSupport);
+    PlatformSetupVar->PcieAspm[4] = FixedPcdGet8 (PcdPcieRootPort4AspmSupport);
+    Status = gRT->SetVariable (
+                    PLATFORM_SETUP_VAR,
+                    &gPlatformSetupVariableGuid,
+                    EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS,
+                    sizeof (PLATFORM_SETUP_DATA),
+                    PlatformSetupVar
+                    );
+    DEBUG ((DEBUG_INFO, "%a: PCIe ASPM set to the default (%u) - %r\n", __func__, FixedPcdGet8 (PcdPcieRootPort0AspmSupport), Status));
+    if (EFI_ERROR (Status)) {
+      return;   // try again next boot
+    }
+  }
+
+  Marker = 1;
+  gRT->SetVariable (
+         DMOD_ASPM_MARKER_VAR,
+         &gPlatformSetupVariableGuid,
+         EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS,
+         sizeof (Marker),
+         &Marker
+         );
+}
+
 EFI_STATUS
 PlatformSetupVariableInit (
   VOID
@@ -575,9 +628,12 @@ PlatformSetupVariableInit (
                     );
     if (EFI_ERROR (Status)) {
       DEBUG ((DEBUG_INFO, "%a: EfiSetVariable failed - %r\n", __FUNCTION__, Status));
+    } else {
+      DmodApplyAspmDefaultOnce (&PlatformSetupVar, FALSE);  // dmod: new variable already has the default
     }
   } else {
     DEBUG ((DEBUG_INFO, "%a: EfiGetVariable Success - %r\n", __FUNCTION__, Status));
+    DmodApplyAspmDefaultOnce (&PlatformSetupVar, TRUE);     // dmod: existing variable, migrate once
   }
 
   return Status;
